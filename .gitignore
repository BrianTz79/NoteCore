# === Secretos: NUNCA subir ===
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example
*.pem
*.key
*.p12
*.jks
*.crt
secrets/
# Credenciales de servicio (Google Play, Expo, Cloudflare…)
**/google-services.json
**/service-account*.json
**/*credentials*.json

# === Respaldo local de la v1 (contiene .env con secretos reales) ===
_respaldo_v1_*/
# Cualquier respaldo o volcado de base de datos
*.sql
*.dump
!apps/api/src/db/migrations/*.sql

# === Dependencias ===
node_modules/
**/node_modules/

# === Builds ===
dist/
build/
out/
**/dist/
**/build/
*.tsbuildinfo

# === Next.js ===
.next/
**/.next/
next-env.d.ts
# Next 16 genera estos archivos para agentes de IA en cada arranque; el CLAUDE.md
# válido es el de la raíz, escrito a mano.
apps/web/CLAUDE.md
apps/web/AGENTS.md

# === React Native / Expo ===
.expo/
.expo-shared/
*.apk
*.aab
# Los keystores nunca se suben: el de release firma la app publicada
*.keystore
# Los directorios nativos los regenera `expo prebuild` a partir de `app.json` y de los
# plugins de `apps/mobile/plugins/`. No se versionan: editarlos a mano se perdería en el
# siguiente prebuild, y la configuración real vive en `app.json`.
apps/mobile/android/
apps/mobile/ios/

# === Logs ===
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# === Sistema / editor ===
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp

# === Temporales ===
tmp/
temp/
.cache/
coverage/
