# Copia este archivo a `.env` y rellena los valores reales.
# NUNCA subas el archivo `.env` al repositorio.

# === PostgreSQL ===
POSTGRES_USER=notecore
POSTGRES_PASSWORD=cambia_esta_password
POSTGRES_DB=notecore
# Desde el host usa `localhost`; dentro de Docker Compose se sobrescribe a `postgres`.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# === Backend ===
PORT=3101
NODE_ENV=development
# Orígenes autorizados para CORS, separados por coma.
CORS_ORIGINS=http://localhost:3000

# URL pública de la web. Es la base de los enlaces de compartición, y lo que se codifica
# en el QR, así que en producción debe ser el dominio real (https://notecore.ourocore.net).
# Si se omite, se toma el primer origen de CORS.
WEB_URL=http://localhost:3000

# === Autenticación ===
# Firma los tokens de sesión. Mínimo 32 caracteres.
# Genera uno con: openssl rand -hex 32
JWT_SECRET=genera_un_secreto_largo_y_aleatorio

# Vida del token de acceso, en minutos. Corto a propósito: se renueva solo.
ACCESS_TOKEN_MINUTES=15

# Vida de la sesión sin volver a entrar, en días.
REFRESH_TOKEN_DAYS=30

# Dominio de las cookies de sesión de la web. Vacío en desarrollo; en producción,
# el dominio que comparten web y API (p. ej. `ourocore.net`).
COOKIE_DOMAIN=

# === Puertos publicados por Docker Compose ===
API_PORT=3101
WEB_PORT=3000

# === Cloudflare Tunnel (opcional, solo para exposición externa) ===
CLOUDFLARE_TUNNEL_TOKEN=

# === App móvil ===
# Para probar en un dispositivo físico, usa la IP de tu PC en la red local,
# no `localhost` (que en el teléfono apunta al propio teléfono).
EXPO_PUBLIC_API_URL=http://localhost:3101

# === Web ===
NEXT_PUBLIC_API_URL=http://localhost:3101

# Prefijo bajo el que el NAVEGADOR alcanza la API. Vacío en desarrollo, donde la web llama
# directamente a `NEXT_PUBLIC_API_URL` sin prefijo. En producción vale `/api`, que es el
# rewrite del mismo origen. Tiene que ir SIEMPRE emparejado con `NEXT_PUBLIC_API_URL`: la
# cookie de refresco lleva este path, y si no coincide con la URL que pide el navegador,
# el navegador no la manda y la sesión de la web muere a los 15 minutos.
WEB_API_PREFIX=

# === Actualización de la app fuera de la tienda (Fase 17) ===
# Apagado por defecto, y así debe quedarse el día que la app suba a Play Store: las tiendas
# PROHÍBEN que una app se autoactualice por fuera. Apagarlo aquí desactiva el mecanismo para
# todos los teléfonos ya instalados, sin publicar una versión nueva.
UPDATER_ENABLED=false

# Directorio del HOST donde viven los APK publicados y su `latest.json`. Se monta en
# `/releases` dentro del contenedor. Lo llena `scripts/publicar-apk.sh`.
RELEASES_HOST_DIR=../releases

# URL pública desde la que la APP alcanza la API. Es la base del enlace de descarga del APK,
# que tiene que ser absoluto porque lo abre el gestor de descargas de Android. En producción
# es `https://notecore-api.ourocore.net`. Vacío en desarrollo: se compone con el host de la
# petición, que es lo correcto cuando la IP del PC en la red local cambia.
PUBLIC_API_URL=

# El interruptor del lado de la APP. Tiene que emparejarse con `UPDATER_ENABLED`: decide a la
# vez si la app pregunta y si el APK lleva el permiso `REQUEST_INSTALL_PACKAGES`. Se lee en
# `expo prebuild`, así que cambiarlo exige rehacer el prebuild, no solo recompilar.
EXPO_PUBLIC_UPDATER_ENABLED=false

# === Producción (referencia; ver la sección 7 de PROYECTO.md) ===
# Los valores de arriba son los de DESARROLLO. En producción cambian así:
#
#   NODE_ENV=production
#   CORS_ORIGINS=https://notecore.ourocore.net
#   WEB_URL=https://notecore.ourocore.net
#   COOKIE_DOMAIN=            <- vacío a propósito: la cookie se fija al host de la web
#   NEXT_PUBLIC_API_URL=/api  <- MISMO ORIGEN que la web, o la cookie `sameSite=lax` no viaja
#   WEB_API_PREFIX=/api       <- el mismo prefijo, para que el path de la cookie coincida
#   EXPO_PUBLIC_API_URL=https://notecore-api.ourocore.net   <- la app usa cabecera, no cookie
#
# Que la web y la app entren por sitios distintos NO es un descuido: la web se autentica
# con cookies (que exigen mismo origen) y la app con un token por cabecera (que no).
