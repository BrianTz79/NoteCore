# Copia este archivo a `.env` y rellena los valores reales.
# NUNCA subas el archivo `.env` al repositorio.

# === PostgreSQL ===
POSTGRES_USER=notecore
POSTGRES_PASSWORD=cambia_esta_password
POSTGRES_DB=notecore
# Desde el host usa `localhost`; dentro de Docker Compose se sobrescribe a `postgres`.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# === Backend ===
PORT=3101
NODE_ENV=development
# Orígenes autorizados para CORS, separados por coma.
CORS_ORIGINS=http://localhost:3000

# URL pública de la web. Es la base de los enlaces de compartición, y lo que se codifica
# en el QR, así que en producción debe ser el dominio real (https://notecore.ourocore.net).
# Si se omite, se toma el primer origen de CORS.
WEB_URL=http://localhost:3000

# === Autenticación ===
# Firma los tokens de sesión. Mínimo 32 caracteres.
# Genera uno con: openssl rand -hex 32
JWT_SECRET=genera_un_secreto_largo_y_aleatorio

# Vida del token de acceso, en minutos. Corto a propósito: se renueva solo.
ACCESS_TOKEN_MINUTES=15

# Vida de la sesión sin volver a entrar, en días.
REFRESH_TOKEN_DAYS=30

# Dominio de las cookies de sesión de la web. Vacío en desarrollo; en producción,
# el dominio que comparten web y API (p. ej. `ourocore.net`).
COOKIE_DOMAIN=

# === Puertos publicados por Docker Compose ===
API_PORT=3101
WEB_PORT=3000

# === Cloudflare Tunnel (opcional, solo para exposición externa) ===
CLOUDFLARE_TUNNEL_TOKEN=

# === App móvil ===
# Para probar en un dispositivo físico, usa la IP de tu PC en la red local,
# no `localhost` (que en el teléfono apunta al propio teléfono).
EXPO_PUBLIC_API_URL=http://localhost:3101

# === Web ===
NEXT_PUBLIC_API_URL=http://localhost:3101
