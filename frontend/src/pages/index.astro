---
import Base from '../layouts/Base.astro';
---
<Base title="Dashboard — Horarios">
  <div id="app" class="min-h-screen flex flex-col bg-gray-50 dark:bg-gray-950 transition-colors">

    <!-- Navbar -->
    <header class="bg-white dark:bg-gray-900 border-b border-gray-200 dark:border-gray-800 px-4 py-3 flex items-center justify-between sticky top-0 z-30 shadow-sm">
      <div class="flex items-center gap-2">
        <span class="text-xl">🎓</span>
        <h1 class="text-base font-bold text-gray-900 dark:text-white">Horarios</h1>
      </div>
      <div class="flex items-center gap-2">
        <span id="user-name" class="text-xs text-gray-500 dark:text-gray-400 hidden sm:inline"></span>
        <button id="btn-theme" title="Cambiar tema"
          class="p-1.5 rounded-lg bg-gray-100 dark:bg-gray-800 text-gray-600 dark:text-gray-400 hover:bg-gray-200 dark:hover:bg-gray-700 transition-colors text-sm">
          🌙
        </button>
        <button id="btn-import" class="px-2.5 py-1.5 bg-indigo-600 hover:bg-indigo-500 text-white text-xs font-medium rounded-lg transition-colors">
          + JSON
        </button>
        <button id="btn-add" class="px-2.5 py-1.5 bg-gray-200 dark:bg-gray-700 hover:bg-gray-300 dark:hover:bg-gray-600 text-gray-800 dark:text-white text-xs font-medium rounded-lg transition-colors">
          + Materia
        </button>
        <button id="btn-logout" class="px-2.5 py-1.5 text-gray-400 hover:text-red-400 text-xs transition-colors">Salir</button>
      </div>
    </header>

    <!-- Semester + controls bar -->
    <div class="bg-white dark:bg-gray-900 border-b border-gray-200 dark:border-gray-800 px-4 py-2 flex items-center gap-3 flex-wrap">
      <label class="text-xs text-gray-500 dark:text-gray-400 font-medium">Semestre:</label>
      <select id="semester-select"
        class="text-xs bg-gray-100 dark:bg-gray-800 border border-gray-200 dark:border-gray-700 text-gray-800 dark:text-white rounded-lg px-2 py-1 focus:outline-none focus:ring-2 focus:ring-indigo-500">
      </select>
      <div class="flex-1"></div>
      <button id="btn-clear" class="text-xs text-red-400 hover:text-red-300 px-2 py-1 rounded-lg hover:bg-red-50 dark:hover:bg-red-900/20 transition-colors">
        Limpiar materias
      </button>
    </div>

    <!-- Tab bar (mobile) -->
    <nav class="bg-white dark:bg-gray-900 border-b border-gray-200 dark:border-gray-800 flex md:hidden sticky top-[57px] z-20">
      <button id="tab-schedule" data-tab="schedule"
        class="tab-btn flex-1 py-2.5 text-xs font-medium text-indigo-600 dark:text-indigo-400 border-b-2 border-indigo-500">
        Horario
      </button>
      <button id="tab-stats" data-tab="stats"
        class="tab-btn flex-1 py-2.5 text-xs font-medium text-gray-500 dark:text-gray-400 border-b-2 border-transparent">
        Asistencias
      </button>
      <button id="tab-absences" data-tab="absences"
        class="tab-btn flex-1 py-2.5 text-xs font-medium text-gray-500 dark:text-gray-400 border-b-2 border-transparent">
        Faltas
      </button>
    </nav>

    <main class="flex-1 md:grid md:grid-cols-3 gap-4 p-3 md:p-5 overflow-auto">

      <!-- Schedule panel -->
      <section id="panel-schedule" class="md:col-span-2 bg-white dark:bg-gray-900 rounded-2xl border border-gray-200 dark:border-gray-800 overflow-hidden">
        <div class="p-3 border-b border-gray-200 dark:border-gray-800 flex items-center justify-between">
          <h2 class="text-sm font-semibold text-gray-900 dark:text-white">Horario Semanal</h2>
          <div class="flex items-center gap-2 text-xs text-gray-500 dark:text-gray-400">
            <button id="prev-week" class="p-1.5 hover:text-indigo-500 rounded-lg hover:bg-gray-100 dark:hover:bg-gray-800">&laquo;</button>
            <span id="week-label" class="min-w-[100px] text-center text-xs"></span>
            <button id="next-week" class="p-1.5 hover:text-indigo-500 rounded-lg hover:bg-gray-100 dark:hover:bg-gray-800">&raquo;</button>
          </div>
        </div>
        <div id="schedule-grid" class="overflow-x-auto">
          <div style="min-width:560px">
            <div id="grid-header" class="grid text-xs font-medium text-gray-400 dark:text-gray-500 border-b border-gray-200 dark:border-gray-800"></div>
            <div id="grid-body"></div>
          </div>
        </div>
      </section>

      <!-- Stats + Absences sidebar -->
      <section id="panel-right" class="hidden md:flex flex-col gap-4">

        <!-- Stats -->
        <div id="panel-stats" class="bg-white dark:bg-gray-900 rounded-2xl border border-gray-200 dark:border-gray-800 p-4">
          <h2 class="text-sm font-semibold text-gray-900 dark:text-white mb-3">Control de Asistencias</h2>
          <div id="stats-list" class="space-y-2">
            <p class="text-gray-400 text-xs">Cargando...</p>
          </div>
        </div>

        <!-- Absences -->
        <div id="panel-absences" class="bg-white dark:bg-gray-900 rounded-2xl border border-gray-200 dark:border-gray-800 p-4">
          <h2 class="text-sm font-semibold text-gray-900 dark:text-white mb-3">Registro de Faltas</h2>
          <div id="absences-list" class="space-y-1.5 max-h-72 overflow-y-auto">
            <p class="text-gray-400 text-xs">Sin faltas registradas.</p>
          </div>
        </div>

      </section>
    </main>
  </div>

  <!-- Modal: Add subject -->
  <div id="modal-add" class="hidden fixed inset-0 bg-black/60 flex items-end sm:items-center justify-center p-0 sm:p-4 z-50">
    <div class="bg-white dark:bg-gray-900 rounded-t-2xl sm:rounded-2xl p-5 w-full sm:max-w-md border-t sm:border border-gray-200 dark:border-gray-800 max-h-[90vh] overflow-y-auto">
      <h3 class="font-semibold text-gray-900 dark:text-white mb-4">Nueva Materia</h3>
      <form id="form-add-subject" class="space-y-3">
        <input name="nombre" required placeholder="Nombre de la materia"
          class="w-full bg-gray-100 dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-lg px-3 py-2.5 text-sm text-gray-900 dark:text-white placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-indigo-500" />
        <input name="paquete" placeholder="Paquete / Grupo (ej. 07B)"
          class="w-full bg-gray-100 dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-lg px-3 py-2.5 text-sm text-gray-900 dark:text-white placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-indigo-500" />
        <div id="bloques-container" class="space-y-2">
          <p class="text-xs text-gray-500 font-medium">Sesiones</p>
        </div>
        <button type="button" id="btn-add-bloque" class="text-xs text-indigo-500 hover:text-indigo-400">+ Agregar sesión</button>
        <div class="flex gap-2 pt-2">
          <button type="button" id="btn-cancel-add" class="flex-1 py-2.5 bg-gray-100 dark:bg-gray-700 hover:bg-gray-200 dark:hover:bg-gray-600 text-gray-800 dark:text-white text-sm rounded-xl">Cancelar</button>
          <button type="submit" class="flex-1 py-2.5 bg-indigo-600 hover:bg-indigo-500 text-white text-sm font-medium rounded-xl">Guardar</button>
        </div>
      </form>
    </div>
  </div>

  <!-- Modal: Edit subject -->
  <div id="modal-edit" class="hidden fixed inset-0 bg-black/60 flex items-end sm:items-center justify-center p-0 sm:p-4 z-50">
    <div class="bg-white dark:bg-gray-900 rounded-t-2xl sm:rounded-2xl p-5 w-full sm:max-w-md border-t sm:border border-gray-200 dark:border-gray-800 max-h-[90vh] overflow-y-auto">
      <h3 class="font-semibold text-gray-900 dark:text-white mb-4">Editar Materia</h3>
      <form id="form-edit-subject" class="space-y-3">
        <input type="hidden" name="id" />
        <input name="nombre" required placeholder="Nombre de la materia"
          class="w-full bg-gray-100 dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-lg px-3 py-2.5 text-sm text-gray-900 dark:text-white placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-indigo-500" />
        <input name="paquete" placeholder="Paquete / Grupo (ej. 07B)"
          class="w-full bg-gray-100 dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-lg px-3 py-2.5 text-sm text-gray-900 dark:text-white placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-indigo-500" />
        <div>
          <label class="text-xs text-gray-500 font-medium block mb-1">Color</label>
          <input name="color" type="color"
            class="w-full h-9 bg-gray-100 dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-lg cursor-pointer" />
        </div>
        <div id="edit-bloques-container" class="space-y-2">
          <p class="text-xs text-gray-500 font-medium">Sesiones</p>
        </div>
        <button type="button" id="btn-edit-add-bloque" class="text-xs text-indigo-500 hover:text-indigo-400">+ Agregar sesión</button>
        <div class="flex gap-2 pt-2">
          <button type="button" id="btn-cancel-edit" class="flex-1 py-2.5 bg-gray-100 dark:bg-gray-700 hover:bg-gray-200 dark:hover:bg-gray-600 text-gray-800 dark:text-white text-sm rounded-xl">Cancelar</button>
          <button type="submit" class="flex-1 py-2.5 bg-indigo-600 hover:bg-indigo-500 text-white text-sm font-medium rounded-xl">Guardar cambios</button>
        </div>
      </form>
    </div>
  </div>

  <!-- Modal: Import JSON -->
  <div id="modal-import" class="hidden fixed inset-0 bg-black/60 flex items-end sm:items-center justify-center p-0 sm:p-4 z-50">
    <div class="bg-white dark:bg-gray-900 rounded-t-2xl sm:rounded-2xl p-5 w-full sm:max-w-2xl border-t sm:border border-gray-200 dark:border-gray-800 max-h-[90vh] overflow-y-auto">
      <h3 class="font-semibold text-gray-900 dark:text-white mb-1">Importar Horario via IA</h3>
      <p class="text-xs text-gray-500 mb-3">
        Copia el prompt, adjunta la captura de tu horario en tu IA favorita y pega el JSON resultante aquí:
      </p>
      <div class="bg-gray-100 dark:bg-gray-800 rounded-xl p-3 mb-3 relative">
        <pre id="prompt-text" class="whitespace-pre-wrap text-xs text-gray-600 dark:text-gray-300 font-mono"></pre>
        <button id="btn-copy-prompt" class="absolute top-2 right-2 px-2 py-1 bg-gray-200 dark:bg-gray-700 hover:bg-gray-300 dark:hover:bg-gray-600 text-xs text-gray-700 dark:text-gray-300 rounded-lg">Copiar</button>
      </div>
      <textarea id="json-input" rows="6" placeholder="Pega aquí el JSON generado por la IA..."
        class="w-full bg-gray-100 dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-xl px-3 py-2 text-xs font-mono text-gray-900 dark:text-white placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-indigo-500 resize-none mb-3"></textarea>
      <div id="import-error" class="hidden mb-3 px-3 py-2 bg-red-50 dark:bg-red-900/30 border border-red-200 dark:border-red-700 rounded-xl text-red-600 dark:text-red-300 text-xs"></div>
      <div class="flex gap-2">
        <button id="btn-cancel-import" class="flex-1 py-2.5 bg-gray-100 dark:bg-gray-700 hover:bg-gray-200 dark:hover:bg-gray-600 text-gray-800 dark:text-white text-sm rounded-xl">Cancelar</button>
        <button id="btn-do-import" class="flex-1 py-2.5 bg-indigo-600 hover:bg-indigo-500 text-white text-sm font-medium rounded-xl">Importar</button>
      </div>
    </div>
  </div>

  <!-- Modal: Absence -->
  <div id="modal-absence" class="hidden fixed inset-0 bg-black/60 flex items-end sm:items-center justify-center p-0 sm:p-4 z-50">
    <div class="bg-white dark:bg-gray-900 rounded-t-2xl sm:rounded-2xl p-5 w-full sm:max-w-sm border-t sm:border border-gray-200 dark:border-gray-800">
      <h3 class="font-semibold text-gray-900 dark:text-white mb-4">Registrar Falta</h3>
      <form id="form-absence" class="space-y-3">
        <input type="hidden" name="subject_id" />
        <input type="hidden" name="schedule_block_id" />
        <div>
          <label class="text-xs text-gray-500 block mb-1">Materia</label>
          <p id="absence-subject-name" class="text-sm text-gray-900 dark:text-white font-medium"></p>
        </div>
        <div>
          <label class="text-xs text-gray-500 block mb-1">Fecha</label>
          <input name="fecha" type="date" required
            class="w-full bg-gray-100 dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-xl px-3 py-2.5 text-sm text-gray-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-indigo-500" />
        </div>
        <div>
          <label class="text-xs text-gray-500 block mb-1">Notas (opcional)</label>
          <input name="notas" type="text" placeholder="Motivo..."
            class="w-full bg-gray-100 dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-xl px-3 py-2.5 text-sm text-gray-900 dark:text-white placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-indigo-500" />
        </div>
        <div class="flex gap-2 pt-2">
          <button type="button" id="btn-cancel-absence" class="flex-1 py-2.5 bg-gray-100 dark:bg-gray-700 hover:bg-gray-200 dark:hover:bg-gray-600 text-gray-800 dark:text-white text-sm rounded-xl">Cancelar</button>
          <button type="submit" class="flex-1 py-2.5 bg-red-600 hover:bg-red-500 text-white text-sm font-medium rounded-xl">Registrar Falta</button>
        </div>
      </form>
    </div>
  </div>

  <!-- Modal: Confirm clear -->
  <div id="modal-confirm-clear" class="hidden fixed inset-0 bg-black/60 flex items-center justify-center p-4 z-50">
    <div class="bg-white dark:bg-gray-900 rounded-2xl p-5 w-full max-w-sm border border-gray-200 dark:border-gray-800">
      <h3 class="font-semibold text-gray-900 dark:text-white mb-2">Limpiar todas las materias</h3>
      <p class="text-sm text-gray-500 mb-5">Esta acción eliminará todas tus materias, bloques y faltas registradas. No se puede deshacer.</p>
      <div class="flex gap-2">
        <button id="btn-cancel-clear" class="flex-1 py-2.5 bg-gray-100 dark:bg-gray-700 text-gray-800 dark:text-white text-sm rounded-xl">Cancelar</button>
        <button id="btn-confirm-clear" class="flex-1 py-2.5 bg-red-600 hover:bg-red-500 text-white text-sm font-medium rounded-xl">Eliminar todo</button>
      </div>
    </div>
  </div>
</Base>

<script>
import "../lib/dashboard.js";
</script>
