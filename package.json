{
  "name": "notecore",
  "version": "0.1.0",
  "private": true,
  "description": "Plataforma de organización académica para estudiantes universitarios",
  "license": "MIT",
  "author": "Brian Tellez <lucio.tellez@gmail.com> (https://briantellez.ourocore.net/)",
  "repository": {
    "type": "git",
    "url": "https://github.com/BrianTz79/NoteCore.git"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build:shared": "npm run build --workspace @notecore/shared",
    "dev:api": "npm run dev --workspace @notecore/api",
    "dev:web": "npm run dev --workspace @notecore/web",
    "dev:mobile": "npm run start --workspace @notecore/mobile",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "db:generate": "npm run db:generate --workspace @notecore/api",
    "db:migrate": "npm run db:migrate --workspace @notecore/api",
    "docker:up": "docker compose -f infra/docker-compose.yml up -d",
    "docker:down": "docker compose -f infra/docker-compose.yml down",
    "docker:logs": "docker compose -f infra/docker-compose.yml logs -f"
  },
  "devDependencies": {
    "typescript": "^5.7.3"
  }
}
