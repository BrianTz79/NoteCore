<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <!--
    Los receptores de los cuatro widgets se declaran aquí, en el propio módulo, y el
    fusionador de manifiestos de Gradle los incorpora al de la app. Así la familia entera
    viaja completa con su módulo en lugar de depender de que un plugin recuerde
    inyectarla.

    `exported="true"` es obligatorio en los cuatro: quien manda el broadcast de
    actualización es el sistema, desde fuera del proceso de la app.

    El `android:label` es lo que se lee en el menú de widgets del lanzador, y por eso lleva
    el nombre del widget y no su descripción: en esa lista aparecen todas las apps
    instaladas, y "Tu próxima clase, en la pantalla de inicio." no dice de qué app es.
  -->
  <application>
    <receiver
        android:name="net.ourocore.notecore.widget.HorarioWidgetProvider"
        android:exported="true"
        android:label="@string/widget_nombre_horario">
      <intent-filter>
        <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
      </intent-filter>
      <meta-data
          android:name="android.appwidget.provider"
          android:resource="@xml/widget_horario_info" />
    </receiver>

    <receiver
        android:name="net.ourocore.notecore.widget.DiaWidgetProvider"
        android:exported="true"
        android:label="@string/widget_nombre_dia">
      <intent-filter>
        <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
      </intent-filter>
      <meta-data
          android:name="android.appwidget.provider"
          android:resource="@xml/widget_dia_info" />
    </receiver>

    <receiver
        android:name="net.ourocore.notecore.widget.FaltasWidgetProvider"
        android:exported="true"
        android:label="@string/widget_nombre_faltas">
      <intent-filter>
        <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
      </intent-filter>
      <meta-data
          android:name="android.appwidget.provider"
          android:resource="@xml/widget_faltas_info" />
    </receiver>

    <receiver
        android:name="net.ourocore.notecore.widget.AgendaWidgetProvider"
        android:exported="true"
        android:label="@string/widget_nombre_agenda">
      <intent-filter>
        <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
      </intent-filter>
      <meta-data
          android:name="android.appwidget.provider"
          android:resource="@xml/widget_agenda_info" />
    </receiver>
  </application>
</manifest>
