{
  "expo": {
    "name": "NoteCore",
    "slug": "notecore",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "notecore",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "platforms": [
      "android"
    ],
    "android": {
      "package": "net.ourocore.notecore",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#0f172a"
      },
      "permissions": [
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "plugins": [
      "expo-secure-store",
      "expo-notifications",
      "./plugins/with-dev-cleartext.js"
    ]
  }
}
